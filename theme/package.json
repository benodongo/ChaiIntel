{
  "name": "chaiintel-theme",
  "private": true,
  "version": "1.0.0",
  "description": "Tailwind v4 build pipeline for the ChaiIntel Django dashboard (TailAdmin-based styling).",
  "scripts": {
    "build": "tailwindcss -i ./src/style.css -o ../analytics/static/analytics/theme/style.css --minify",
    "watch": "tailwindcss -i ./src/style.css -o ../analytics/static/analytics/theme/style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^4.0.0"
  }
}
